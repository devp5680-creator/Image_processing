\f0\fs24 \cf2 clc; clear; close all;
\f1 \cf0 \page 
\f0 \cf2 % Read an image and convert it to\
double precision\
I =\
im2double(imread('cameraman.tif'));\
% Display the original image\
figure, imshow(I);\
title('Original Image');\
% Create a 3x3 averaging filter and\
blur the image\
h = fspecial('average', [3 3]);\
blurred = imfilter(I, h, 'replicate');\
% Create a mask (difference between\
original and blurred)\
mask = I - blurred;\
% Perform Unsharp Masking (k = 1)\
k = 1;\
unsharp_image = I + k * mask;\
% Display the unsharp masked image\
figure, imshow(unsharp_image, []);\
title('Unsharp Masking (k = 1)');
\f1 \cf0 \page 
\f0 \cf2 % Perform High-Boost Filtering with\
different amplification factors\
k_values = [1.5, 2, 3];\
for i = 1:length(k_values)\
k = k_values(i);\
highboost_image = I + k * mask;\
figure, imshow(highboost_image,\
[]);\
title(['High-Boost Filtering (k = ',\
num2str(k), ')']);\
end\
% Display all results together for\
comparison\
figure;\
subplot(2,3,1), imshow(I),\
title('Original Image');\
subplot(2,3,2), imshow(blurred),\
title('Blurred Image');\
subplot(2,3,3), imshow(mask, []),\
title('Mask (I - Blurred)');\
subplot(2,3,4),\
imshow(unsharp_image, []),\
title('Unsharp Masking (k=1)');\
subplot(2,3,5), imshow(I + 2*mask,\
[]), title('High-Boost (k=2)');
\f1 \cf0 \page 
\f0 \cf2 subplot(2,3,6), imshow(I + 3*mask,\
[]), title('High-Boost (k=3)');
